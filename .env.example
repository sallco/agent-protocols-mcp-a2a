# Copia este archivo como .env y coloca las credenciales localmente.
# Nunca subas el archivo .env al repositorio.

# NVIDIA Build / NIM
NVIDIA_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=z-ai/glm-5.3
MODEL_FALLBACKS=z-ai/glm-5.3-flash

# PostgreSQL local con pgvector
POSTGRES_DB=parachutedb
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachutepass
DATABASE_URL=postgresql://parachute:parachutepass@localhost:5432/parachutedb

# Tablas y búsqueda vectorial
FAQ_TABLE=faqs
CITAS_TABLE=citas
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MINIMUM_SIMILARITY=0.6

# Open-Meteo y condiciones del evento
OPENMETEO_LAT=14.013722
OPENMETEO_LON=-90.771611
OPENMETEO_TIMEZONE=America/Guatemala
FORECAST_MAX_DAYS=16
# La fecha histórica se inyecta en pruebas y demostraciones; no usar BASE_DATE.
WEATHER_EVAL_MODE=operativo_horario
